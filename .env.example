# ═══════════════════════════════════════════════════════════
#  IMS Command Center — Central Environment Configuration
# ═══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
SERVER_PORT=8080
PROCESSOR_PORT=8081

# ── Rate Limiting ─────────────────────────────────────────
# [CHANGE THIS] To test different Rate Limits, modify these two values.
# RATE_LIMIT is the steady-state allowed requests per second.
# RATE_BURST is the maximum allowed instantaneous spike.
RATE_LIMIT=10000
RATE_BURST=10000

# ── Redis ─────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_NAME=ims:signals
REDIS_HOST_PORT=6380

# ── Worker Pool ───────────────────────────────────────────
WORKER_COUNT=4
CONSUMER_GROUP=ims-processor-group
CONSUMER_NAME_PREFIX=worker
DEBOUNCE_WINDOW_SEC=10

# ── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=ims
MONGO_HOST_PORT=27018

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=ims
POSTGRES_PASSWORD=ims_secret
POSTGRES_DB=ims
POSTGRES_URI=postgres://ims:ims_secret@postgres:5432/ims?sslmode=disable
POSTGRES_HOST_PORT=5433

# ── Aggregator ────────────────────────────────────────────
AGGREGATOR_INTERVAL_SEC=60

# ── Frontend ──────────────────────────────────────────────
FRONTEND_PORT=3000
